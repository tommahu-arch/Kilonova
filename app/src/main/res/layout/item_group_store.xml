<?xml version="1.0" encoding="utf-8"?>
<!-- The Drawer groups page's store card: where the categories come from,
     when they were last looked up, and the two actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_card"
    android:orientation="vertical"
    android:padding="@dimen/space_ml">

    <TextView
        android:id="@+id/storeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/store_card_title"
        android:textColor="@color/textPrimary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/storeBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:lineSpacingExtra="2sp"
        android:text="@string/store_card_body"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/text_secondary" />

    <TextView
        android:id="@+id/storeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:textColor="@color/textSecondary"
        android:textSize="@dimen/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_ms"
        android:orientation="horizontal">

        <Button
            android:id="@+id/storeAddGroups"
            style="@style/Widget.Supernova.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/store_add_groups"
            android:textColor="?attr/colorAccentOnRaised" />

        <Button
            android:id="@+id/storeSync"
            style="@style/Widget.Supernova.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:text="@string/store_update_now"
            android:textColor="?attr/colorAccentOnRaised" />
    </LinearLayout>
</LinearLayout>
